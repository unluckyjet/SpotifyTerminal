#!/usr/bin/env node
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const root = path.dirname(path.dirname(fs.realpathSync(__filename)));
const result = spawnSync(path.join(root, 'node_modules/.bin/bun'), [path.join(root, 'src/index.ts'), ...process.argv.slice(2)], { stdio: 'inherit' });
if (result.error) console.error('Run npm install in ' + root + ' first.');
process.exit(result.status ?? 1);
